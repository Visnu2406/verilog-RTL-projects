<?xml version="1.0" encoding="UTF-8"?>
<wave_config>
   <wave_state>
   </wave_state>
   <db_ref_list>
      <db_ref path="shifter_tb_behav.wdb" id="1">
         <top_modules>
            <top_module name="glbl" />
            <top_module name="shifter_tb" />
         </top_modules>
      </db_ref>
   </db_ref_list>
   <zoom_setting>
      <ZoomStartTime time="0.000 ns"></ZoomStartTime>
      <ZoomEndTime time="40.001 ns"></ZoomEndTime>
      <Cursor1Time time="14.695 ns"></Cursor1Time>
   </zoom_setting>
   <column_width_setting>
      <NameColumnWidth column_width="248"></NameColumnWidth>
      <ValueColumnWidth column_width="107"></ValueColumnWidth>
   </column_width_setting>
   <WVObjectSize size="5" />
   <wvobject fp_name="/shifter_tb/clock" type="logic">
      <obj_property name="ElementShortName">clock</obj_property>
      <obj_property name="ObjectShortName">clock</obj_property>
   </wvobject>
   <wvobject fp_name="/shifter_tb/d_in" type="array">
      <obj_property name="ElementShortName">d_in[7:0]</obj_property>
      <obj_property name="ObjectShortName">d_in[7:0]</obj_property>
      <obj_property name="Radix">BINARYRADIX</obj_property>
   </wvobject>
   <wvobject fp_name="/shifter_tb/op" type="array">
      <obj_property name="ElementShortName">op[2:0]</obj_property>
      <obj_property name="ObjectShortName">op[2:0]</obj_property>
      <obj_property name="Radix">BINARYRADIX</obj_property>
   </wvobject>
   <wvobject fp_name="/shifter_tb/capture_n" type="logic">
      <obj_property name="ElementShortName">capture_n</obj_property>
      <obj_property name="ObjectShortName">capture_n</obj_property>
   </wvobject>
   <wvobject fp_name="/shifter_tb/q" type="array">
      <obj_property name="ElementShortName">q[7:0]</obj_property>
      <obj_property name="ObjectShortName">q[7:0]</obj_property>
      <obj_property name="Radix">BINARYRADIX</obj_property>
   </wvobject>
</wave_config>
